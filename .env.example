# Firebase client config (from Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Used by local scripts (generateProductBook.js, seedKnowledge.js, etc.)
# Cloud Functions use Firebase Secret Manager instead — set via:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Etsy OAuth — used by scripts/etsyAuth.js local flow
# Cloud Functions use Firebase Secret Manager for ETSY_API_KEY / ETSY_API_SECRET
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# fal.ai — Cloud Functions use Firebase Secret Manager (FAL_KEY)
# Only needed here if running fal.ai calls from local scripts
# FAL_KEY=
